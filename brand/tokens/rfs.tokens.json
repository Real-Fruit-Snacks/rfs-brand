  ],
  "font": {
    "display": "\"Big Shoulders Stencil\", \"Arial Narrow\", sans-serif",
    "sans": "\"Albert Sans\", system-ui, -apple-system, sans-serif",
    "mono": "\"Azeret Mono\", ui-monospace, \"Cascadia Code\", Consolas, monospace"
  },
  "type": {
    "display": [72, 0.96, 800, 0.055],
    "headline": [48, 1.0, 700, 0.055],
    "title": [26, 1.05, 700, 0.055],
    "body": [16, 1.55, 400, 0],
    "small": [14, 1.5, 400, 0],
    "label": [12.5, 1.2, 600, 0.08],
    "code": [13.5, 1.6, 400, 0],
    "wordmark": [null, 0.92, 800, 0.055]
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "9": 96
  },
  "radius": {
    "tile": "0.219em (14/64)",
    "sm": "6px",
    "card": "10px",
    "chip": "6px"
  },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "ease-exit": "cubic-bezier(0.7, 0, 0.84, 0)",
    "ease-linear": "linear",
    "dur-fast": "150ms",
    "dur-base": "250ms",
    "dur-slow": "520ms",
    "type-rate": "45ms"
  },
  "code": {
    "white-space": "pre-wrap",
    "overflow-wrap": "anywhere",
    "word-break": "normal",
    "tab-size": 2,
    "scroll-opt-in": ".rfs-code-scroll"
  },
  "syntax": {
    "keyword": "steel-ink",
    "function": "beacon-ink",
    "string": "accent",
    "number": "signal",
    "comment": "mute",
    "diff-add": "signal",
    "diff-del": "fault"
  },
  "icon": {
    "count": 60,
    "grid": 24,
    "stroke-width": "1.75px",
    "sizes": [16, 20, 24, 32],
    "linecap": "square",
    "linejoin": "miter",
    "fill": "none",
    "sprite": "brand/icons/rfs-icons.svg"
  },
  "cli": {
    "ok": { "tag": "[ok]", "ansi16": "green", "dark": "#3DDC97", "light": "#127247" },
    "warn": { "tag": "[!]", "ansi16": "yellow", "dark": "#FFC247", "light": "#885800" },
    "fail": { "tag": "[x]", "ansi16": "magenta", "dark": "#F06292", "light": "#B0306A" },
    "prompt": { "tag": "$", "ansi16": "bright-red", "dark": "#FF9254", "light": "#AD3D0A" },
    "info": { "tag": "[i]", "ansi16": "cyan", "dark": "#74B8E8", "light": "#164669" },
    "no-color-env": "NO_COLOR",
    "exit-codes": { "ok": 0, "runtime-error": 1, "usage-error": 2 }
  },
  "z-index": {
    "base": 0,
    "sticky": 20,
    "nav": 40,
    "popover": 60,
    "modal": 80,
    "toast": 100
  },
  "breakpoints": {
    "sm": "36em",
    "md": "56em",
    "lg": "72em"
  },
  "ux-contracts": {
    "scrollbar-placement": "below-header-app-shell-only",
    "native-browser-dialogs": "forbidden (never use alert, confirm, or prompt)",
    "destructive-confirmation": "required branded native <dialog> with autofocus on Cancel and .rfs-btn-fault confirm"
  },
  "theme": {
    "default": "dark",
    "names": {
      "dark": "Beacon Horizon (LX 263)",
      "light": "Alabaster Day (LX 512)"
    },
    "palette": "Steel & Beacon Orange"
  }
}
